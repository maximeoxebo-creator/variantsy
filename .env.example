# ---------------------------------------------------------------------------
# Variantsy — variables d'environnement
# Copier ce fichier en `.env` (jamais commité) et remplir les valeurs.
# Les MÊMES variables doivent être renseignées dans Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Depuis Partner Dashboard → ton app → Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# URL publique de l'app (prod Vercel). En dev, le CLI la surcharge automatiquement.
SHOPIFY_APP_URL=https://variantsy.vercel.app

# Handle de l'app (celui de l'URL admin : /charges/<handle>/pricing_plans)
# Utilisé par le gate de billing pour construire l'URL de la page de pricing.
SHOPIFY_APP_HANDLE=variantsy

# Scopes — doivent correspondre EXACTEMENT à ceux de shopify.app.toml
SCOPES=read_products,write_products

# Postgres Neon. IMPORTANT : la même URL doit être utilisée en local quand tu lances
# `npm run db:deploy`, sinon tu migres la mauvaise base.
# Utiliser l'URL "pooled" (-pooler) pour l'app, et l'URL directe pour les migrations.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&pool_timeout=15"
DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
