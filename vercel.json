{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "remix",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "regions": ["cdg1"],
  "headers": [
    {
      "source": "/proxy/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=600" }
      ]
    }
  ]
}
